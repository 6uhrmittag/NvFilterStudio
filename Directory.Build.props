<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- InvariantGlobalization is deliberately NOT set. It looks like a free
         win for a small app, but WPF needs real culture data: XmlLanguage
         cannot resolve a specific culture for "en-us" without it, and the
         window dies on its first layout pass with
         "Cannot find non-neutral culture related to 'en-us'". The failure only
         appears at runtime, so the build stays green while the shipped .exe
         does not start. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- The store encoding is unforgiving and its failures are silent, so the
         build is strict: warnings are errors and analyzers run at the highest
         practical level. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Overridden from the git tag on tag builds; see .github/workflows/ci.yml.
         Without a version the published .exe has blank Properties fields and a
         bug report cannot name the build it came from. -->
    <VersionPrefix>0.2.0</VersionPrefix>

    <Authors>6uhrmittag</Authors>
    <Product>NvFilterStudio</Product>
    <Copyright>Copyright (c) 2026 6uhrmittag</Copyright>
    <RepositoryUrl>https://github.com/6uhrmittag/NvFilterStudio</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
