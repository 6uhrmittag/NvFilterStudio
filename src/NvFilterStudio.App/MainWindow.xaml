<Window x:Class="NvFilterStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NvFilterStudio.App.ViewModels"
        Title="NvFilterStudio"
        Icon="Assets/app.ico"
        Width="900" Height="740"
        MinWidth="660" MinHeight="540"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ApplyCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportFileCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyShareCodeCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl+Shift" Command="{Binding PasteShareCodeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <vm:ZeroToVisibleConverter x:Key="EmptyToVisible" />
        <vm:TextToVisibleConverter x:Key="TextToVisible" />
        <vm:InverseBoolToVisibleConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="TrueToVisible" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="4,0,0,16">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="✿" FontSize="22" Foreground="{DynamicResource BlushBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="NvFilterStudio" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <TextBlock Text="inspect · edit · share" Style="{StaticResource HintText}"
                       VerticalAlignment="Bottom" Margin="12,0,0,4" />
            <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource HintText}"
                       VerticalAlignment="Bottom" Margin="10,0,0,4" Opacity="0.7" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource TinyButton}"
                Content="{Binding ThemeGlyph}" FontSize="14"
                AutomationProperties.Name="Switch between light and dark"
                Command="{Binding ToggleThemeCommand}"
                ToolTip="Switch between light and dark" />
        </Grid>

        <!-- read error -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                Background="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource WarnEdgeBrush}"
                Visibility="{Binding LoadError, Converter={StaticResource TextToVisible}}">
            <StackPanel>
                <TextBlock Text="Couldn't read your filters" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LoadError}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- pickers -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Game" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                               Width="52" Foreground="{DynamicResource InkSoftBrush}" />
                    <!-- An explicit ItemTemplate rather than DisplayMemberPath: the
                         custom ComboBox template renders the selection through
                         SelectionBoxItemTemplate, which DisplayMemberPath does not
                         populate, so the box fell back to ToString(). -->
                    <ComboBox Style="{StaticResource SoftCombo}"
                              ItemContainerStyle="{StaticResource SoftComboItem}"
                              ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                              MinWidth="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="↻" Style="{StaticResource TinyButton}" Margin="10,0,0,0"
                            AutomationProperties.Name="Re-read filters from NVIDIA"
                            Command="{Binding ReloadCommand}" ToolTip="Re-read from NVIDIA" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Slot" Style="{StaticResource BodyText}" VerticalAlignment="Top"
                               Width="52" Margin="0,8,0,0" Foreground="{DynamicResource InkSoftBrush}" />
                    <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chip"
                                                    Background="{DynamicResource SunkenBrush}"
                                                    CornerRadius="{StaticResource PillRadius}"
                                                    BorderBrush="{DynamicResource EdgeBrush}"
                                                    BorderThickness="1" Padding="18,7"
                                                    TextElement.Foreground="{DynamicResource InkBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background"
                                                            Value="{DynamicResource BlushBrush}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush"
                                                            Value="{DynamicResource BlushBrush}" />
                                                    <!-- This text sits on the pink accent, so it needs
                                                         the on-accent ink. Without it the summary line
                                                         all but vanishes in dark mode. -->
                                                    <Setter TargetName="Chip" Property="TextElement.Foreground"
                                                            Value="{DynamicResource InkOnAccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush"
                                                            Value="{DynamicResource BlushBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlotOption}">
                                <!-- Foreground is deliberately not set here. The chip template
                                     supplies it, switching to on-accent ink when selected, and an
                                     explicit Foreground on the TextBlock would win over that and
                                     leave the label unreadable on the pink. -->
                                <StackPanel TextElement.FontFamily="{StaticResource UiFont}">
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                               FontSize="{StaticResource BodySize}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" HorizontalAlignment="Center"
                                               FontSize="{StaticResource SmallSize}" Opacity="0.75" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- filter stack -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilterViewModel}">
                                <Border Background="{DynamicResource CardBrush}"
                                        CornerRadius="{StaticResource ControlRadius}"
                                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                                        Padding="14,12" Margin="4,4,4,10">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource LavenderBrush}"
                                                        CornerRadius="{StaticResource PillRadius}"
                                                        Padding="10,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Order}" Style="{StaticResource BodyText}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           FontWeight="SemiBold" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Shader}" Style="{StaticResource HintText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource ButterBrush}"
                                                        CornerRadius="{StaticResource PillRadius}"
                                                        Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="These sliders aren't named yet. The values are still correct."
                                                        Visibility="{Binding HasUnmappedControls,
                                                                     Converter={StaticResource TrueToVisible}}">
                                                    <TextBlock Text="unnamed sliders" Style="{StaticResource HintText}"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="↑" Style="{StaticResource TinyButton}"
                                                        ToolTip="Apply earlier in the stack"
                                                        AutomationProperties.Name="Move filter earlier in the stack"
                                                        Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓" Style="{StaticResource TinyButton}" Margin="6,0,0,0"
                                                        ToolTip="Apply later in the stack"
                                                        AutomationProperties.Name="Move filter later in the stack"
                                                        Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="reset" Style="{StaticResource TinyButton}" Margin="6,0,0,0"
                                                        ToolTip="Back to NVIDIA defaults"
                                                        Command="{Binding DataContext.ResetFilterCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" Style="{StaticResource TinyButton}" Margin="6,0,0,0"
                                                        ToolTip="Remove from this slot"
                                                        AutomationProperties.Name="Remove filter from this slot"
                                                        Command="{Binding DataContext.RemoveFilterCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Controls}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ControlViewModel}">
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="175" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource BodyText}" />
                                                            <TextBlock Text="{Binding SecondaryLabel}"
                                                                       Style="{StaticResource HintText}"
                                                                       Visibility="{Binding SecondaryLabel,
                                                                                    Converter={StaticResource TextToVisible}}" />
                                                        </StackPanel>

                                                        <Slider Grid.Column="1" Style="{StaticResource KawaiiSlider}"
                                                                AutomationProperties.Name="{Binding Name}"
                                                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                                                Value="{Binding Value, Mode=TwoWay}"
                                                                VerticalAlignment="Center" Margin="6,0" />

                                                        <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                                                 AutomationProperties.Name="{Binding Name}"
                                                                 Text="{Binding ValueText, Mode=TwoWay,
                                                                        UpdateSourceTrigger=LostFocus}"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource HintText}" Margin="14,16" TextAlignment="Center"
                               Text="This slot is empty — add a filter below to start building a look ♡"
                               Visibility="{Binding Filters.Count, Converter={StaticResource EmptyToVisible}}" />

                    <StackPanel Orientation="Horizontal" Margin="4,6,4,4">
                        <ComboBox Style="{StaticResource SoftCombo}"
                                  ItemContainerStyle="{StaticResource SoftComboItem}"
                                  ItemsSource="{Binding AddableFilters}" SelectedItem="{Binding FilterToAdd}"
                                  MinWidth="210">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="＋ Add filter" Style="{StaticResource SoftButton}" Margin="8,0,0,0"
                                Command="{Binding AddFilterCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- footer -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,0,10"
                    Background="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource WarnEdgeBrush}"
                    Visibility="{Binding CanWrite, Converter={StaticResource FalseToVisible}}">
                <TextBlock Text="{Binding BlockedHint}" Style="{StaticResource HintText}"
                           Foreground="{DynamicResource InkBrush}" />
            </Border>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="♡ Copy share code" Style="{StaticResource SoftButton}"
                            ToolTip="Copy this slot as a share code (Ctrl+Shift+C)"
                            Command="{Binding CopyShareCodeCommand}" />
                    <Button Content="Paste" Style="{StaticResource SoftButton}" Margin="8,0,0,0"
                            Command="{Binding PasteShareCodeCommand}" />
                    <Button Content="⇩ Export" Style="{StaticResource SoftButton}" Margin="8,0,0,0"
                            Command="{Binding ExportFileCommand}" />
                    <Button Content="⇪ Import" Style="{StaticResource SoftButton}" Margin="8,0,0,0"
                            Command="{Binding ImportFileCommand}" />
                </StackPanel>

                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        Content="Apply to NVIDIA ✿" Command="{Binding ApplyCommand}"
                        ToolTip="Write these filters back to NVIDIA (Ctrl+S)" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                <Border Background="{DynamicResource ButterBrush}"
                        CornerRadius="{StaticResource PillRadius}"
                        Padding="10,2" Margin="0,0,10,0" VerticalAlignment="Center"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource TrueToVisible}}">
                    <TextBlock Text="unsaved changes" Style="{StaticResource HintText}"
                               Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·" Style="{StaticResource HintText}" Margin="8,0"
                           VerticalAlignment="Center" Opacity="0.5" />
                <!-- Backups are written before every apply and are otherwise
                     invisible; showing the size makes them discoverable rather
                     than a surprise found months later. -->
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink Command="{Binding OpenBackupsCommand}"
                               AutomationProperties.Name="Open the backups folder"
                               ToolTip="Open the backups folder"
                               Foreground="{DynamicResource InkSoftBrush}">
                        <TextBlock Text="{Binding BackupSummary}"
                                   Style="{StaticResource HintText}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
