<!--
    Colour tokens.

    Soft and pastel, but the contrast on text is kept real: a cute tool that
    cannot be read while matching a profile against a friend's screenshot has
    failed at the only job that matters. Body text sits near 7:1 on its
    background, and no value is ever conveyed by hue alone.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- surfaces -->
    <Color x:Key="CanvasColor">#FFFDF9FB</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="SunkenColor">#FFF6EEF4</Color>

    <!-- accents -->
    <Color x:Key="BlushColor">#FFF48FB1</Color>
    <Color x:Key="BlushSoftColor">#FFFFD9E4</Color>
    <Color x:Key="LavenderColor">#FFB39DDB</Color>
    <Color x:Key="MintColor">#FF80CBC4</Color>
    <Color x:Key="ButterColor">#FFFFE0A3</Color>

    <!-- text -->
    <Color x:Key="InkColor">#FF3B2F36</Color>
    <Color x:Key="InkSoftColor">#FF7A6A73</Color>
    <Color x:Key="InkOnAccentColor">#FF3B2F36</Color>

    <!-- state -->
    <Color x:Key="EdgeColor">#FFEBDDE5</Color>
    <Color x:Key="WarnColor">#FFFFF3D6</Color>
    <Color x:Key="WarnEdgeColor">#FFE8C77A</Color>
    <Color x:Key="GoodColor">#FFDFF5EE</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SunkenBrush" Color="{StaticResource SunkenColor}" />
    <SolidColorBrush x:Key="BlushBrush" Color="{StaticResource BlushColor}" />
    <SolidColorBrush x:Key="BlushSoftBrush" Color="{StaticResource BlushSoftColor}" />
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="ButterBrush" Color="{StaticResource ButterColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="InkOnAccentBrush" Color="{StaticResource InkOnAccentColor}" />
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnEdgeBrush" Color="{StaticResource WarnEdgeColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />

    <!-- shape and rhythm -->
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <!-- Half the 8px track height. A pill radius larger than half the
         element height makes WPF draw a tapered lens instead of a bar. -->
    <CornerRadius x:Key="TrackRadius">4</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="NumberFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <system:Double x:Key="TitleSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">19</system:Double>
    <system:Double x:Key="BodySize" xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Double>
    <system:Double x:Key="SmallSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">11.5</system:Double>

</ResourceDictionary>
